{
  "format": "lisanhub.plugin/1",
  "plugin_id": "classic-exercises",
  "version": "1.0.0",
  "schema_version": 1,
  "name": {
    "ar": "التمارين الكلاسيكية",
    "fr": "Exercices classiques",
    "en": "Classic exercises"
  },
  "description": {
    "ar": "أربعة أنواع من التمارين: اختيار من متعدّد، إكمال فراغ، مطابقة، وترتيب كلمات. يُقيَّم كل تمرين بمقيّمات المنصّة المرجعية.",
    "fr": "Quatre types d’exercices : choix multiple, texte à trous, appariement et ordre des mots. Chaque exercice est noté par les évaluateurs de référence de la plateforme.",
    "en": "Four exercise types: multiple choice, fill in the blank, matching and word order. Each is scored by the platform’s reference evaluators."
  },
  "activities": [
    {
      "id": "multiple-choice",
      "name": {
        "ar": "اختيار من متعدّد",
        "fr": "Choix multiple",
        "en": "Multiple choice"
      },
      "description": {
        "ar": "سؤال بخيارات، واحد منها صحيح.",
        "fr": "Une question à options, dont une seule est correcte.",
        "en": "A question with options, one of them correct."
      },
      "skill": "reading",
      "fields": [
        {
          "key": "prompt",
          "label": {
            "ar": "السؤال",
            "fr": "Question",
            "en": "Prompt"
          },
          "hint": {
            "ar": "السؤال أو التعليمة كما يراها المتعلّم.",
            "fr": "La question ou la consigne telle que l’apprenant la voit.",
            "en": "The question or instruction as the learner sees it."
          },
          "required": true,
          "type": "short_text",
          "max_length": 300
        },
        {
          "key": "picture",
          "label": {
            "ar": "صورة",
            "fr": "Image",
            "en": "Picture"
          },
          "hint": {
            "ar": "اختياري. صورة توضّح السؤال، مع نصّ بديل يصفها.",
            "fr": "Facultatif. Une image qui illustre la question, avec un texte alternatif.",
            "en": "Optional. A picture illustrating the prompt, with alternative text."
          },
          "required": false,
          "type": "image"
        },
        {
          "key": "options",
          "label": {
            "ar": "الخيارات",
            "fr": "Options",
            "en": "Options"
          },
          "hint": {
            "ar": "من خيارين إلى ستة، وعلّم الصحيح.",
            "fr": "De deux à six options ; marquez la bonne.",
            "en": "Two to six options; mark the correct one."
          },
          "required": true,
          "type": "single_choice",
          "min_options": 2,
          "max_options": 6
        }
      ],
      "graded_field": "options",
      "scoring": {
        "evaluator": "multiple_choice"
      }
    },
    {
      "id": "fill-blank",
      "name": {
        "ar": "إكمال فراغ",
        "fr": "Texte à trous",
        "en": "Fill in the blank"
      },
      "description": {
        "ar": "نصّ فيه فراغات يكتب المتعلّم ما يملؤها؛ التشكيل العربي لا يُحتسب.",
        "fr": "Un texte à trous que l’apprenant complète ; les diacritiques arabes sont ignorés.",
        "en": "A text with gaps the learner fills in; Arabic diacritics are ignored."
      },
      "skill": "writing",
      "fields": [
        {
          "key": "prompt",
          "label": {
            "ar": "السؤال",
            "fr": "Question",
            "en": "Prompt"
          },
          "hint": {
            "ar": "تعليمة قصيرة، مثل: أكمل الجملة.",
            "fr": "Une consigne courte, par exemple : complétez la phrase.",
            "en": "A short instruction, such as: complete the sentence."
          },
          "required": true,
          "type": "short_text",
          "max_length": 300
        },
        {
          "key": "picture",
          "label": {
            "ar": "صورة",
            "fr": "Image",
            "en": "Picture"
          },
          "hint": {
            "ar": "اختياري. صورة توضّح السؤال، مع نصّ بديل يصفها.",
            "fr": "Facultatif. Une image qui illustre la question, avec un texte alternatif.",
            "en": "Optional. A picture illustrating the prompt, with alternative text."
          },
          "required": false,
          "type": "image"
        },
        {
          "key": "gap",
          "label": {
            "ar": "النصّ بفراغاته",
            "fr": "Texte et trous",
            "en": "Text with gaps"
          },
          "hint": {
            "ar": "ضع {{0}} و{{1}}… مكان الفراغات، ثم اكتب الأجوبة المقبولة لكل فراغ.",
            "fr": "Placez {{0}}, {{1}}… à l’emplacement des trous, puis les réponses acceptées pour chacun.",
            "en": "Put {{0}}, {{1}}… where the gaps go, then the accepted answers for each."
          },
          "required": true,
          "type": "blank_in_text",
          "max_blanks": 5
        }
      ],
      "graded_field": "gap",
      "scoring": {
        "evaluator": "fill_blank",
        "ignore_case": true,
        "ignore_arabic_diacritics": true
      }
    },
    {
      "id": "matching",
      "name": {
        "ar": "مطابقة",
        "fr": "Appariement",
        "en": "Matching"
      },
      "description": {
        "ar": "أزواج يطابق المتعلّم طرفيها.",
        "fr": "Des paires dont l’apprenant relie les deux côtés.",
        "en": "Pairs whose two sides the learner matches."
      },
      "skill": "reading",
      "fields": [
        {
          "key": "prompt",
          "label": {
            "ar": "السؤال",
            "fr": "Question",
            "en": "Prompt"
          },
          "hint": {
            "ar": "تعليمة قصيرة، مثل: طابق كل كلمة بمعناها.",
            "fr": "Une consigne courte, par exemple : associez chaque mot à son sens.",
            "en": "A short instruction, such as: match each word with its meaning."
          },
          "required": true,
          "type": "short_text",
          "max_length": 300
        },
        {
          "key": "picture",
          "label": {
            "ar": "صورة",
            "fr": "Image",
            "en": "Picture"
          },
          "hint": {
            "ar": "اختياري. صورة توضّح السؤال، مع نصّ بديل يصفها.",
            "fr": "Facultatif. Une image qui illustre la question, avec un texte alternatif.",
            "en": "Optional. A picture illustrating the prompt, with alternative text."
          },
          "required": false,
          "type": "image"
        },
        {
          "key": "pairs",
          "label": {
            "ar": "الأزواج",
            "fr": "Paires",
            "en": "Pairs"
          },
          "hint": {
            "ar": "من زوجين إلى عشرة.",
            "fr": "De deux à dix paires.",
            "en": "Two to ten pairs."
          },
          "required": true,
          "type": "matching_pairs",
          "min_pairs": 2,
          "max_pairs": 10
        }
      ],
      "graded_field": "pairs",
      "scoring": {
        "evaluator": "matching"
      }
    },
    {
      "id": "word-order",
      "name": {
        "ar": "ترتيب كلمات",
        "fr": "Ordre des mots",
        "en": "Word order"
      },
      "description": {
        "ar": "كلمات مبعثرة يعيد المتعلّم ترتيبها.",
        "fr": "Des mots mélangés que l’apprenant remet dans l’ordre.",
        "en": "Shuffled words the learner puts back in order."
      },
      "skill": "writing",
      "fields": [
        {
          "key": "prompt",
          "label": {
            "ar": "السؤال",
            "fr": "Question",
            "en": "Prompt"
          },
          "hint": {
            "ar": "تعليمة قصيرة، مثل: رتّب الكلمات لتكوين جملة.",
            "fr": "Une consigne courte, par exemple : remettez les mots dans l’ordre.",
            "en": "A short instruction, such as: put the words in order."
          },
          "required": true,
          "type": "short_text",
          "max_length": 300
        },
        {
          "key": "picture",
          "label": {
            "ar": "صورة",
            "fr": "Image",
            "en": "Picture"
          },
          "hint": {
            "ar": "اختياري. صورة توضّح السؤال، مع نصّ بديل يصفها.",
            "fr": "Facultatif. Une image qui illustre la question, avec un texte alternatif.",
            "en": "Optional. A picture illustrating the prompt, with alternative text."
          },
          "required": false,
          "type": "image"
        },
        {
          "key": "words",
          "label": {
            "ar": "الكلمات بترتيبها الصحيح",
            "fr": "Mots dans le bon ordre",
            "en": "Words in the correct order"
          },
          "hint": {
            "ar": "اكتبها بالترتيب الصحيح؛ المشغّل يخلطها للمتعلّم.",
            "fr": "Écrivez-les dans le bon ordre ; le lecteur les mélange pour l’apprenant.",
            "en": "Write them in the correct order; the player shuffles them for the learner."
          },
          "required": true,
          "type": "ordering",
          "min_tokens": 2,
          "max_tokens": 20
        }
      ],
      "graded_field": "words",
      "scoring": {
        "evaluator": "word_order"
      }
    }
  ],
  "templates": [
    {
      "id": "lesson-starter",
      "name": {
        "ar": "درس تمارين",
        "fr": "Leçon d’exercices",
        "en": "Exercise lesson"
      },
      "description": {
        "ar": "تمرين واحد من كل نوع لتبدأ منه؛ احذف ما لا تحتاجه وأضف ما تريد.",
        "fr": "Un exercice de chaque type pour commencer ; supprimez ce dont vous n’avez pas besoin et ajoutez le reste.",
        "en": "One exercise of each type to start from; remove what you do not need and add more."
      },
      "items": [
        {
          "activity": "multiple-choice",
          "hints": {}
        },
        {
          "activity": "fill-blank",
          "hints": {}
        },
        {
          "activity": "matching",
          "hints": {}
        },
        {
          "activity": "word-order",
          "hints": {}
        }
      ]
    }
  ],
  "content_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": ["items"],
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "oneOf": [
            {
              "type": "object",
              "required": ["item_id", "activity", "fields"],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                },
                "activity": {
                  "const": "multiple-choice"
                },
                "skill": {
                  "enum": ["listening", "reading", "pronunciation", "writing"]
                },
                "fields": {
                  "type": "object",
                  "required": ["prompt", "options"],
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "picture": {
                      "type": "object",
                      "required": ["asset", "alt"],
                      "properties": {
                        "asset": {
                          "type": "string",
                          "pattern": "^assets\\/[a-z0-9][a-z0-9._-]*$"
                        },
                        "alt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "additionalProperties": false
                    },
                    "options": {
                      "type": "object",
                      "required": ["options", "correct"],
                      "properties": {
                        "options": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": ["id", "text"],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "text": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            },
                            "additionalProperties": false
                          },
                          "minItems": 2,
                          "maxItems": 6
                        },
                        "correct": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 64
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["item_id", "activity", "fields"],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                },
                "activity": {
                  "const": "fill-blank"
                },
                "skill": {
                  "enum": ["listening", "reading", "pronunciation", "writing"]
                },
                "fields": {
                  "type": "object",
                  "required": ["prompt", "gap"],
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "picture": {
                      "type": "object",
                      "required": ["asset", "alt"],
                      "properties": {
                        "asset": {
                          "type": "string",
                          "pattern": "^assets\\/[a-z0-9][a-z0-9._-]*$"
                        },
                        "alt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "additionalProperties": false
                    },
                    "gap": {
                      "type": "object",
                      "required": ["template", "blanks"],
                      "properties": {
                        "template": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 5000
                        },
                        "blanks": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 5,
                          "items": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            }
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["item_id", "activity", "fields"],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                },
                "activity": {
                  "const": "matching"
                },
                "skill": {
                  "enum": ["listening", "reading", "pronunciation", "writing"]
                },
                "fields": {
                  "type": "object",
                  "required": ["prompt", "pairs"],
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "picture": {
                      "type": "object",
                      "required": ["asset", "alt"],
                      "properties": {
                        "asset": {
                          "type": "string",
                          "pattern": "^assets\\/[a-z0-9][a-z0-9._-]*$"
                        },
                        "alt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "additionalProperties": false
                    },
                    "pairs": {
                      "type": "object",
                      "required": ["pairs"],
                      "properties": {
                        "pairs": {
                          "type": "array",
                          "minItems": 2,
                          "maxItems": 10,
                          "items": {
                            "type": "object",
                            "required": ["id", "left", "right"],
                            "properties": {
                              "id": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 64
                              },
                              "left": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              },
                              "right": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 500
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": ["item_id", "activity", "fields"],
              "properties": {
                "item_id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{3,63}$"
                },
                "activity": {
                  "const": "word-order"
                },
                "skill": {
                  "enum": ["listening", "reading", "pronunciation", "writing"]
                },
                "fields": {
                  "type": "object",
                  "required": ["prompt", "words"],
                  "properties": {
                    "prompt": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 300
                    },
                    "picture": {
                      "type": "object",
                      "required": ["asset", "alt"],
                      "properties": {
                        "asset": {
                          "type": "string",
                          "pattern": "^assets\\/[a-z0-9][a-z0-9._-]*$"
                        },
                        "alt": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 300
                        }
                      },
                      "additionalProperties": false
                    },
                    "words": {
                      "type": "object",
                      "required": ["tokens"],
                      "properties": {
                        "tokens": {
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 200
                          },
                          "minItems": 2,
                          "maxItems": 20
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "additionalProperties": false
  },
