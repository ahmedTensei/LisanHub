# Copy to .env.local and fill in. Never commit .env.local.
# Hosted project: Supabase dashboard -> Project Settings -> API (public values only, never service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# File storage (decision R13, docs/adr/0008-files-on-cloudflare-r2.md): every file — packages,
# package assets, profile pictures — lives in Cloudflare R2; Supabase keeps accounts and metadata.
# `r2` (default) needs the four values below; `memory` runs a session without any storage account.
STORAGE_PROVIDER=r2
# Cloudflare dashboard -> R2 -> Overview: the account id (32 hex characters).
R2_ACCOUNT_ID=
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens -> Create API token:
# "Admin Read & Write" lets `npm run storage:verify` create the buckets; "Object Read & Write" limited
# to the two buckets is enough afterwards. The token page shows both values once.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Jurisdiction the buckets are created in: empty (automatic) or eu (European Union) or fedramp.
R2_JURISDICTION=eu
# Bucket names (created by `npm run storage:verify` when missing).
STORAGE_BUCKET_PUBLIC=lisanhub-public
STORAGE_BUCKET_PRIVATE=lisanhub-private
# Optional: public domain connected to the public bucket (R2 -> bucket -> Settings -> Custom Domains).
# Empty = the app serves public pictures itself at /api/media/<key>.
R2_PUBLIC_BASE_URL=
# Optional: another S3-compatible endpoint (MinIO for local experiments); empty = Cloudflare R2.
R2_ENDPOINT=

# Sandboxed player document (docs/adr/0006, open decision Q20). Empty = same origin as the app.
# Before public launch, serve the app on a separate subdomain too and point this at it.
PLAYER_ORIGIN=
