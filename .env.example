# Copy to .env.local and fill in. Never commit .env.local.
# Local development: run `npm run db:start`, then copy the values it prints.
# Hosted project: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# File storage (docs/adr/0005-storage-abstraction.md). Defaults: Supabase Storage with these buckets.
# Switching provider later is configuration only: object keys in the database are relative paths.
STORAGE_PROVIDER=supabase
STORAGE_BUCKET_PUBLIC=media-public
STORAGE_BUCKET_PRIVATE=media-private
